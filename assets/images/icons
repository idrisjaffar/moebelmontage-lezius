    <!-- ============================================================
       SCRIPTS
       ============================================================ -->
    <script>
        (function() {
            'use strict';

            // ── THEME TOGGLE ──
            const html = document.documentElement;
            const themeToggle = document.getElementById('themeToggle');
            const themeIcon = document.getElementById('themeIcon');

            const storedTheme = localStorage.getItem('fixjori-theme');
            const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            let currentTheme = storedTheme || (systemPrefersDark ? 'dark' : 'light');

            function applyTheme(theme) {
                html.setAttribute('data-theme', theme);
                localStorage.setItem('fixjori-theme', theme);
                themeIcon.className = theme === 'dark' ? 'fas fa-sun' : 'fas fa-moon';
            }
            applyTheme(currentTheme);

            themeToggle.addEventListener('click', function() {
                currentTheme = currentTheme === 'light' ? 'dark' : 'light';
                applyTheme(currentTheme);
            });

            // ── DATE DISPLAY ──
            const now = new Date();
            document.getElementById('dateDisplay').textContent = now.toLocaleDateString('de-DE', {
                weekday: 'short',
                day: '2-digit',
                month: 'short',
                year: 'numeric'
            });

            // ── TABS ──
            const tabs = document.querySelectorAll('.tab-btn');
            const rows = document.querySelectorAll('#projectTableBody tr');

            tabs.forEach(function(tab) {
                tab.addEventListener('click', function() {
                    tabs.forEach(function(t) { t.classList.remove('active'); });
                    this.classList.add('active');

                    const filter = this.dataset.status;
                    rows.forEach(function(row) {
                        const status = row.dataset.status;
                        if (filter === 'all' || status === filter) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                        }
                    });
                });
            });

            // ── SEARCH ──
            const searchInput = document.getElementById('projectSearch');
            const searchBtn = document.querySelector('.filter-bar .btn-secondary');

            function filterProjects() {
                const term = searchInput.value.toLowerCase().trim();
                rows.forEach(function(row) {
                    const text = row.textContent.toLowerCase();
                    if (term === '' || text.includes(term)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }

            if (searchBtn) {
                searchBtn.addEventListener('click', filterProjects);
            }
            searchInput.addEventListener('keydown', function(e) {
                if (e.key === 'Enter') filterProjects();
            });

            // ── CATEGORY FILTER ──
            const categoryFilter = document.getElementById('categoryFilter');
            categoryFilter.addEventListener('change', function() {
                const filter = this.value;
                rows.forEach(function(row) {
                    const category = row.dataset.category;
                    if (filter === 'all' || category === filter) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });

            // ── HANDYMAN FILTER ──
            const handymanFilter = document.getElementById('handymanFilter');
            handymanFilter.addEventListener('change', function() {
                const filter = this.value;
                rows.forEach(function(row) {
                    const handyman = row.dataset.handyman;
                    if (filter === 'all' || handyman === filter) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });

            // ── SORT ──
            const sortFilter = document.getElementById('sortFilter');
            const tableBody = document.getElementById('projectTableBody');

            sortFilter.addEventListener('change', function() {
                const sort = this.value;
                const rowsArray = Array.from(rows);

                rowsArray.sort(function(a, b) {
                    if (sort === 'newest') {
                        return 0;
                    } else if (sort === 'budget_high') {
                        const priceA = parseFloat(a.querySelectorAll('td')[6]?.textContent?.replace(/[^0-9,.]/g,
                            '').replace(',', '.') || 0);
                        const priceB = parseFloat(b.querySelectorAll('td')[6]?.textContent?.replace(/[^0-9,.]/g,
                            '').replace(',', '.') || 0);
                        return priceB - priceA;
                    } else if (sort === 'budget_low') {
                        const priceA = parseFloat(a.querySelectorAll('td')[6]?.textContent?.replace(/[^0-9,.]/g,
                            '').replace(',', '.') || 0);
                        const priceB = parseFloat(b.querySelectorAll('td')[6]?.textContent?.replace(/[^0-9,.]/g,
                            '').replace(',', '.') || 0);
                        return priceA - priceB;
                    } else if (sort === 'progress') {
                        const progA = parseInt(a.querySelector('.percentage')?.textContent || '0');
                        const progB = parseInt(b.querySelector('.percentage')?.textContent || '0');
                        return progB - progA;
                    }
                    return 0;
                });

                rowsArray.forEach(function(row) {
                    tableBody.appendChild(row);
                });
            });

            // ── RESET FILTERS ──
            window.resetFilters = function() {
                searchInput.value = '';
                categoryFilter.value = 'all';
                handymanFilter.value = 'all';
                sortFilter.value = 'newest';
                // Reset tab
                tabs.forEach(function(t) { t.classList.remove('active'); });
                tabs[0].classList.add('active');
                // Show all rows
                rows.forEach(function(row) {
                    row.style.display = '';
                });
            };

            window.applyFilters = function() {
                filterProjects();
                // Also apply category and handyman
                const cat = categoryFilter.value;
                const handyman = handymanFilter.value;
                rows.forEach(function(row) {
                    const category = row.dataset.category;
                    const handymanAttr = row.dataset.handyman;
                    const matchCat = cat === 'all' || category === cat;
                    const matchHandyman = handyman === 'all' || handymanAttr === handyman;
                    if (matchCat && matchHandyman) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            };

            // ── PAGINATION ──
            window.goToPage = function(page) {
                document.querySelectorAll('.pagination .page').forEach(function(p) {
                    p.classList.remove('active');
                });
                document.querySelector(`.pagination .page[data-page="${page}"]`).classList.add('active');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            };

            window.changePage = function(dir) {
                const pages = document.querySelectorAll('.pagination .page:not(.arrow)');
                let current = 0;
                pages.forEach(function(p, i) {
                    if (p.classList.contains('active')) current = i;
                });
                let next = dir === 'prev' ? current - 1 : current + 1;
                if (next < 0) next = 0;
                if (next >= pages.length) next = pages.length - 1;
                pages[next].click();
            };

            // ── BUTTON INTERACTIONS ──
            document.querySelectorAll('.btn-green.btn-xs').forEach(function(btn) {
                if (btn.textContent.trim() === '✓') {
                    btn.addEventListener('click', function(e) {
                        e.stopPropagation();
                        const row = this.closest('tr');
                        const name = row.querySelector('td:first-child div:first-child')?.textContent || 'Projekt';
                        if (confirm(`"${name}" als abgeschlossen markieren?`)) {
                            const statusCell = row.querySelectorAll('td')[4];
                            if (statusCell) {
                                statusCell.innerHTML =
                                    '<span class="status-badge completed"><i class="fas fa-check-circle"></i> Abgeschlossen</span>';
                            }
                            row.dataset.status = 'completed';
                            row.classList.add('completed');
                            row.classList.remove('overdue');
                            // Update progress
                            const fill = row.querySelector('.fill');
                            if (fill) {
                                fill.style.width = '100%';
                                fill.classList.add('completed');
                            }
                            const percentage = row.querySelector('.percentage');
                            if (percentage) percentage.textContent = '100%';
                            alert(`✅ ${name} wurde als abgeschlossen markiert.`);
                        }
                    });
                }
            });

            // ── DETAILS BUTTON ──
            document.querySelectorAll('.btn-secondary.btn-xs').forEach(function(btn) {
                if (btn.textContent.trim() === 'Details') {
                    btn.addEventListener('click', function(e) {
                        e.stopPropagation();
                        const row = this.closest('tr');
                        const name = row.querySelector('td:first-child div:first-child')?.textContent ||
                            'Projekt';
                        alert(`📋 Details für "${name}" anzeigen (simuliert)`);
                    });
                }
            });

            // ── BEARBEITEN BUTTON ──
            document.querySelectorAll('.btn-outline.btn-xs').forEach(function(btn) {
                if (btn.textContent.trim() === 'Bearbeiten') {
                    btn.addEventListener('click', function(e) {
                        e.stopPropagation();
                        const row = this.closest('tr');
                        const name = row.querySelector('td:first-child div:first-child')?.textContent ||
                            'Projekt';
                        alert(`✏️ "${name}" bearbeiten (simuliert)`);
                    });
                }
            });

            // ── URGENT BUTTON ──
            document.querySelectorAll('.btn-amber.btn-xs').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const row = this.closest('tr');
                    const name = row.querySelector('td:first-child div:first-child')?.textContent || 'Projekt';
                    if (confirm(`⚠️ " ${name} " als überfällig markieren?`)) {
                        const statusCell = row.querySelectorAll('td')[4];
                        if (statusCell) {
                            statusCell.innerHTML =
                                '<span class="status-badge overdue"><i class="fas fa-exclamation-triangle"></i> Überfällig</span>';
                        }
                        row.dataset.status = 'overdue';
                        row.classList.add('overdue');
                        alert(`⚠️ ${name} wurde als überfällig markiert.`);
                    }
                });
            });

            console.log('✅ FIXJORI Project Oversight (Meituan-Style) loaded.');
            console.log('📊 8 projects displayed with SVG category icons.');
            console.log('📁 Category icons available in assets/images/icons/');
        })();
    </script>

</body>
